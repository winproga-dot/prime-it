{
  "name": "prime-it-landing",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite",
    "build": "node scripts/prepare-assets.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "qa:static": "node scripts/check-static.mjs",
    "qa:browser": "node scripts/qa-browser.mjs",
    "qa:lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.453.0"
  },
  "devDependencies": {
    "vite": "^7.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "sharp": "^0.34.3",
    "playwright": "^1.55.1",
    "@axe-core/playwright": "^4.10.2",
    "lighthouse": "^13.5.0"
  }
}
