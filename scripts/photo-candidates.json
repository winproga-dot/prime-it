    "index": 13,
    "title": "File:Fully equipped Lenovo ThinkPad X220 motherboard with keyboard bezel.jpg",
    "fileUrl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f0/Fully_equipped_Lenovo_ThinkPad_X220_motherboard_with_keyboard_bezel.jpg/1920px-Fully_equipped_Lenovo_ThinkPad_X220_motherboard_with_keyboard_bezel.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail",
    "sourceUrl": "https://commons.wikimedia.org/wiki/File:Fully_equipped_Lenovo_ThinkPad_X220_motherboard_with_keyboard_bezel.jpg",
    "artist": "<bdi><a href=\"https://en.wikipedia.org/wiki/en:Siarhei_Besarab\" class=\"extiw\" title=\"w:en:Siarhei Besarab\"><span title=\"Belarusian scientist, chemist, inventor, science communicator\">Siarhei Besarab</span></a></bdi>",
